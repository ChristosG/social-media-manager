# === Email Server Configuration ===
# Copy this file to .env and fill in your values

# Your domain (required)
MAIL_DOMAIN=example.com

# Mail server hostname (defaults to mail.MAIL_DOMAIN)
# MAIL_HOSTNAME=mail.example.com

# From name shown in emails
MAIL_FROM_NAME=Notifications

# From address (defaults to noreply@MAIL_DOMAIN)
# MAIL_FROM_ADDRESS=noreply@example.com

# Relay SMTP server (required — your outbound mail relay)
RELAY_HOST=linux260.papaki.gr
RELAY_PORT=465
RELAY_USER=noreply@example.com
RELAY_PASSWORD=your-email-password

# API key for authenticating requests to the email service (required — generate a strong random key)
API_KEY=change-me-to-a-secure-random-string

# Rate limits (per minute)
RATE_LIMIT_PER_RECIPIENT=10
RATE_LIMIT_GLOBAL=100
