# ── PostgreSQL ──
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auth_db
POSTGRES_PORT=5432

# ── Auth Service ──
AUTH_GRPC_PORT=50051
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432
AUTH_DB_USER=platform
AUTH_DB_PASSWORD=changeme
AUTH_DB_NAME=auth_db
AUTH_DB_SSLMODE=disable

# JWT (generate with: make generate-keys)
JWT_PRIVATE_KEY=base64-encoded-ed25519-private-key
JWT_PUBLIC_KEY=base64-encoded-ed25519-public-key
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# MFA encryption
MFA_ENCRYPTION_KEY=32-byte-base64-encoded-key

# OAuth2 providers (leave empty to disable)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URL=https://cgrigoriadis.online/auth/callback/facebook

# ── API Gateway ──
GATEWAY_HTTP_PORT=8080
GATEWAY_AUTH_SERVICE_ADDR=auth:50051
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_RATE_LIMIT_RPS=100

