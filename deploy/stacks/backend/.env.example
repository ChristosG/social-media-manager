# Backend stack environment
AUTH_DB_HOST=npo-postgres   # project-specific alias; the bare name `postgres` collides with other stacks on a shared docker bridge
AUTH_DB_PORT=5432
AUTH_DB_SSL_MODE=disable
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auth_db
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
MFA_ENCRYPTION_KEY=
GATEWAY_AUTH_SERVICE_ADDR=auth:50051
GATEWAY_CORS_ALLOWED_ORIGINS=https://cgrigoriadis.online
GATEWAY_RATE_LIMIT_RPS=100
GATEWAY_EXTERNAL_PORT=8080
