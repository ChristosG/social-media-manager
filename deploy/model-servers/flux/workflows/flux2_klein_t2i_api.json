{
  "loader_unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "flux-2-klein-4b-fp8.safetensors", "weight_dtype": "default" }
  },
  "loader_clip": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2" }
  },
  "loader_vae": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "a red fox in a snowy forest, cinematic", "clip": ["loader_clip", 0] }
  },
  "neg": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["pos", 0] }
  },
  "latent": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "scheduler": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": 4, "width": 1024, "height": 1024 }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": { "model": ["loader_unet", 0], "positive": ["pos", 0], "negative": ["neg", 0], "cfg": 1.0 }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 42 }
  },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler_select", 0],
      "sigmas": ["scheduler", 0],
      "latent_image": ["latent", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["loader_vae", 0] }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": { "images": ["decode", 0], "filename_prefix": "flux2klein" }
  }
}
