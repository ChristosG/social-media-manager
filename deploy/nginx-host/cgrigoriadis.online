# ====================================================
# Platform — Host Nginx → Docker Nginx proxy
# ====================================================
# sudo cp /mnt/nvme2TB/microservices_agents/deploy/nginx-host/cgrigoriadis.online /etc/nginx/sites-available/cgrigoriadis.online
# sudo nginx -t
# sudo systemctl reload nginx
# ====================================================

server {
    listen 80;
    listen [::]:80;
    server_name cgrigoriadis.online www.cgrigoriadis.online;

    # Certbot ACME challenge (host-level cert renewal)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    listen [::]:443 ssl;
    server_name cgrigoriadis.online www.cgrigoriadis.online;
    include snippets/cloudflare-origin-allow.conf;   # only accept origin traffic from Cloudflare
    include snippets/cloudflare-realip.conf;          # recover the true client IP (CF-Connecting-IP)

    server_tokens off;

    # Host-level SSL (Let's Encrypt via certbot)
    ssl_certificate /etc/letsencrypt/live/cgrigoriadis.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cgrigoriadis.online/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 50M;

    # Pass everything to Docker nginx
    location / {
        proxy_pass http://127.0.0.1:8880;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 60s;
        proxy_connect_timeout 10s;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
