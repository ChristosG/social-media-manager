# ─── Domain & SSL ───
DOMAIN=cgrigoriadis.online
CERTBOT_EMAIL=your@email.com

# ─── Nginx ───
NGINX_BIND_ADDR=127.0.0.1       # Bind published ports to loopback (behind a host reverse proxy). 0.0.0.0 = standalone.
NGINX_HTTP_PORT=8880            # Host port for Docker nginx HTTP
NGINX_HTTPS_PORT=8443           # Host port for Docker nginx HTTPS
MAX_BODY_SIZE=50M
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# ─── Frontend ───
WEBAPP_DIR=nextjs-starter
GATEWAY_URL=http://gateway:8080     # Docker network (same machine)
# GATEWAY_URL=https://api.example.com  # Real URL (separate machines)

# ─── PostgreSQL ───
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auth_db
POSTGRES_PORT=5433

# ─── JWT (Ed25519 raw bytes, base64) ───
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# ─── MFA ───
MFA_ENCRYPTION_KEY=


# ─── Backend (same-machine defaults) ───
AUTH_DB_HOST=npo-postgres   # project-specific alias; the bare name `postgres` collides with other stacks on a shared docker bridge
AUTH_DB_PORT=5432
AUTH_DB_SSL_MODE=disable
GATEWAY_AUTH_SERVICE_ADDR=auth:50051
GATEWAY_CORS_ALLOWED_ORIGINS=https://cgrigoriadis.online
GATEWAY_RATE_LIMIT_RPS=100
GATEWAY_EXTERNAL_PORT=8080

# ─── Redis ───
REDIS_ADDR=redis:6379

# ─── Chat Service ───
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
TRITON_HOST=triton
TRITON_PORT=8001
LLM_TRITON_MODEL_DIR=
VLLM_BASE_URL=
VLLM_DEFAULT_MODEL=/engines2/NVIDIA-Nemotron-Nano-9B-v2-FP8
QWEN_VLLM_BASE_URL=
QWEN_VLLM_DEFAULT_MODEL=/models/Qwen3.5-9B
GATEWAY_CHAT_SERVICE_ADDR=chat-service:50052
GATEWAY_CHAT_SERVICE_WS_URL=chat-service:8081

LLM_SYSTEM_PROMPT=You are a concise, knowledgeable assistant. Answer questions directly and clearly. Keep responses short unless the user asks for detail. Use markdown formatting when helpful. Do not repeat the question back. Do not add unnecessary caveats or disclaimers.

# ─── LLM Parameters ───
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.85
LLM_MAX_TOKENS=4096
LLM_REPETITION_PENALTY=1.1
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0

# --- NPO agent-service ---
GATEWAY_AGENT_SERVICE_URL=http://agent-service:8085
GATEWAY_AGENT_SERVICE_WS_URL=agent-service:8085
# Network ACL: shared secret the gateway + nginx inject as X-Proxy-Secret; agent-service rejects any
# request/WS without it (only the proxies can reach it). Empty = disabled. Generate: openssl rand -hex 32
AGENT_PROXY_SECRET=
# Two DB roles (both REQUIRED): npo_owner runs migrations (DDL); npo_app is the DML-only runtime role.
NPO_OWNER_PASSWORD=change_me_npo_owner_password
NPO_DB_PASSWORD=change_me_npo_app_password
# Self-hosted models — see deploy/model-servers/. These in-cluster URLs match the bundled servers.
# LLM_BASE_URL/LLM_MODEL are set in the agent-service compose (qwen-vllm:6888). Override here if needed.
EMBED_BASE_URL=http://qwen-emb-vllm:8090/v1
EMBED_MODEL=qwen3-emb-4b
# FLUX image server (on the HOST by default, reached via host.docker.internal; or use http://flux-api:8000 on platform-net)
FLUX_BASE_URL=http://host.docker.internal:8000
# Optional public web research (leave blank to disable web_search grounding)
TAVILY_API_KEY=
# Stable secret for signed image URLs (defaults to NPO_OWNER_PASSWORD in compose if unset).
# Must be >=16 chars — the agent refuses to sign image URLs with a weak/empty key (org-enumeration guard).
IMAGE_URL_SECRET=
META_OAUTH_REDIRECT=https://your-domain.example/api/v1/social/callback  # public origin; also used to build Meta-fetchable image URLs for publishing

# ─── Observability: Langfuse (optional) ───
# Leave blank to run with tracing off. To enable: bring up deploy/stacks/observability,
# create a project in the Langfuse UI (http://localhost:3001), paste its keys here, redeploy agent-service.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_URL=http://localhost:3001   # browser-reachable Langfuse URL (for the "Open Langfuse" link)
# Only needed when running the bundled self-hosted Langfuse stack:
LANGFUSE_NEXTAUTH_SECRET=        # openssl rand -base64 32
LANGFUSE_SALT=                   # openssl rand -base64 32
LANGFUSE_DB_PASSWORD=langfuse
